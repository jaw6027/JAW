# Copy to .env for Docker Compose. Python does not load this file automatically.
# For direct Python commands, export these variables in your shell.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
SITE_URL=https://your-domain.com
DATA_DIR=/data
# Optional until you enable real subscriptions. Never commit real credentials.
RESEND_API_KEY=
EMAIL_FROM=
